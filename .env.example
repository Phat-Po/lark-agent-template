# ============================================================
# Lark/Feishu App Credentials
# Get these from: https://open.feishu.cn/app
# See docs/feishu-app-setup.md for step-by-step guide
# ============================================================
LARK_APP_ID=
LARK_APP_SECRET=

# ============================================================
# LLM Provider Configuration
# This agent uses the OpenAI-compatible SDK.
# Change BASE_URL and API_KEY to use any compatible provider.
# ============================================================

# --- Option 1: OpenAI (default) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4o

# --- Option 2: Mimo API ---
# LLM_BASE_URL=https://api.mimo.ai/v1
# LLM_API_KEY=your-mimo-api-key
# LLM_MODEL=mimo-v2.5

# --- Option 3: DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=your-deepseek-key
# LLM_MODEL=deepseek-chat

# --- Option 4: Local (Ollama, vLLM, etc.) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=llama3

# Active config (uncomment one set above, or fill in directly):
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ============================================================
# Agent Configuration
# ============================================================
APP_ENV=production
MAX_HISTORY_ROUNDS=20
MAX_HISTORY_TOKENS=1800
MAX_TOKEN_BUDGET=3000
REQUIRE_WRITE_CONFIRMATION=true

# Display name shown in interactive card headers
BOT_DISPLAY_NAME=Lark Agent

# Optional: path to a custom system prompt file
# SYSTEM_PROMPT_FILE=prompts/my_prompt.txt

# ============================================================
# Search Tool (optional — only needed if using the web_search tool)
# Get an API key from: https://serpapi.com/
# ============================================================
# SEARCH_API_KEY=

# ============================================================
# Database
# ============================================================
DB_PATH=data/agent.db

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
